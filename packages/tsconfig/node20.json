{
	"$schema": "https://json.schemastore.org/tsconfig",
	"display": "Node 20",
	"extends": "./base.json",
	"compilerOptions": {
		"lib": [
			"ES2021"
		],
		"target": "ES2021",
		"types": ["node"],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	}
}
