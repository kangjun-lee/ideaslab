{
	"extends": "@ideaslab/tsconfig/nextjs.json",
	"include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx"],
	"compilerOptions": {
		"composite": true,
		"paths": {
			"~/*": ["./src/*"]
		},
		"skipLibCheck": true,
		"noUncheckedSideEffectImports": false,
		"types": ["node", "react", "react-dom"]
	},
	"exclude": ["node_modules", ".next", "../../node_modules"]
}
