{
	"name": "@ideaslab/server",
	"version": "1.0.0",
	"license": "AGPL",
	"files": [
		"dist/**",
		"assets/**"
	],
	"types": "dist/index.d.ts",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc --project tsconfig.json && tsc-alias",
		"start": "node ./dist",
		"register": "node ./dist --register",
		"register:metadata": "tsx src/scripts/register-metadata.ts",
		"test": "tsx --test \"src/**/*.test.ts\"",
		"lint": "eslint \"src/**/*.ts\" --fix"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.13",
		"@prisma/client": "^6.3.0",
		"@trpc/server": "^11.19.0",
		"axios": "^1.20.0",
		"chalk": "^5.6.0",
		"discord.js": "^14.27.0",
		"dokdo": "^1.1.0",
		"dotenv": "^16.4.7",
		"form-data": "^4.0.6",
		"ioredis": "^5.4.2",
		"iron-session": "^6.3.1",
		"jsonwebtoken": "^9.0.3",
		"module-alias": "^2.2.3",
		"node-schedule": "^2.1.1",
		"strip-ansi": "^7.1.0",
		"superjson": "^2.2.2",
		"uuid": "^11.1.1",
		"winston": "^3.17.0"
	},
	"devDependencies": {
		"@ideaslab/db": "workspace:*",
		"@ideaslab/eslint-config": "workspace:*",
		"@ideaslab/tsconfig": "workspace:*",
		"@ideaslab/validator": "workspace:*",
		"@types/jsonwebtoken": "^8.5.9",
		"@types/node": "^22.13.0",
		"@types/node-schedule": "^2.1.7",
		"@types/uuid": "^9.0.8",
		"chokidar": "^3.6.0",
		"concurrently": "^7.6.0",
		"eslint": "^9.0.0",
		"fast-glob": "^3.3.3",
		"nodemon": "^2.0.22",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.10",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3"
	}
}
